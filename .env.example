# Application Settings
NODE_ENV=development

# Backend Settings
BACKEND_PORT=3000
LOG_LEVEL=info

# Frontend Settings
FRONTEND_PORT=4000
PUBLIC_API_URL=http://localhost:3000

# Database Settings
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ainewsagent
POSTGRES_SSL=false

# Redis Settings
REDIS_HOST=localhost
REDIS_PORT=6379

# Encryption Key (must be set for production)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace_with_a_secure_random_key_32_bytes_or_longer

# Email Settings
EMAIL_API_KEY=your_email_service_api_key
EMAIL_FROM=updates@yourdomain.com
EMAIL_FROM_NAME=AI News Agent